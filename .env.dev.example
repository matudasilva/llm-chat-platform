DEV_PROJECT=llm-chat-platform-dev
POSTGRES_DB=llmchat
POSTGRES_USER=llmchat
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://llmchat:change-me@postgres:5432/llmchat

# RAG corpus (ORQ-21) — see .env.example for the full explanation.
POSTGRES_APP_PASSWORD=change-me-app
DATABASE_URL_APP=postgresql+asyncpg://rag_app:change-me-app@postgres:5432/llmchat
RAG_ENABLED=false
RAG_EMBEDDING_DIMENSIONS=1536

# Isolated reranking benchmark (ORQ-22). See .env.example for details.
AWS_RERANK_REGION=ca-central-1
AWS_RERANK_MODEL=amazon.rerank-v1:0
GCP_PROJECT_ID=
GCP_RERANK_LOCATION=global
GCP_RERANK_MODEL=semantic-ranker-default-004
GOOGLE_ADC_HOST_PATH=/path/to/application_default_credentials.json
QWEN_MODEL_ID=
QWEN_DEVICE=cuda
RERANKING_BENCHMARK_GCP_ENABLED=false
RERANKING_BENCHMARK_AWS_ENABLED=false
RERANKING_BENCHMARK_QWEN_ENABLED=false
RERANKING_BENCHMARK_GCP_CALL_BUDGET=0
RERANKING_BENCHMARK_AWS_PACING_S=15
