flowchart TD
    U["User"] -->|"X-Tenant-ID header\n(or JWT / fallback 'default')"| TM["TenantMiddleware\n(pure ASGI, outermost)"]
    TM -->|"sets ContextVar tenant_id"| API["/chat"]
    API -->|"reads get_tenant_id()"| S["Chat Service"]
    S --> RP["ResilientProvider\n(retry + fallback)"]
    RP --> LLM["LLM Provider"]
    S --> DB[("PostgreSQL\nconv.tenant_id\nmsg.tenant_id")]
    S --> C[("Redis\nchat:response:{tenant_id}:{sha256}")]
    TM -->|"TenantContextFilter\non root handler"| LOG["Structured Logs\n(tenant_id in every record)"]

    style TM fill:#e8f4f8,stroke:#2196F3
    style LOG fill:#f0f8e8,stroke:#4CAF50
