flowchart TD
    U["User"] ==> TM["TenantMiddleware<br/>(outermost)"]
    TM ==> API["/chat"]

    subgraph APP["Application Flow"]
        API ==> CS["Chat Service<br/>orchestrates chat request"]
        CS ==> RL["Routing Layer<br/>selects provider path"]
        RL ==> PF["Provider Factory<br/>resolves LLM provider"]
        PF ==> RP["ResilientProvider<br/>(retry + fallback)"]
        RP ==> LP["LLM Provider"]
    end

    subgraph STATE["Persistence and Cache"]
        PG[("PostgreSQL")]
        RD[("Redis<br/>chat:response:{tenant_id}:…")]
    end

    CS -->|persist / load chat data| PG
    CS -->|cache / ephemeral state| RD
