# App
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=llm-chat-platform
API_PORT=8000

# Provider
PROVIDER=stub
PROVIDER_TIMEOUT_S=30

# Stub provider
STUB_PROVIDER_MODE=ok
STUB_SIMULATED_LATENCY_MS=0

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_ATTEMPTS=3
OPENAI_BACKOFF_BASE_MS=200
OPENAI_BACKOFF_MAX_MS=2000

# Postgres (recommended Docker service name: postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=llmchat
POSTGRES_USER=llmchat
POSTGRES_PASSWORD=__CHANGEME__

# DATABASE_URL (computed by settings.database_url)
# SQLAlchemy (single source of truth for DB connectivity)
DATABASE_URL=postgresql+asyncpg://llmchat:change_me@postgres:5432/llmchat

# RAG corpus (ORQ-21): dedicated, unprivileged application role for the
# pgvector-backed corpus. Provisioned once via scripts/postgres-init/ from
# POSTGRES_APP_PASSWORD, never via Alembic (roles are cluster-level).
# DATABASE_URL_APP must NOT fall back to DATABASE_URL — see spec.md §Design
# decisions 4. Leave both blank while RAG_ENABLED=false.
POSTGRES_APP_PASSWORD=__CHANGEME__
DATABASE_URL_APP=postgresql+asyncpg://rag_app:change_me@postgres:5432/llmchat
RAG_ENABLED=false
RAG_EMBEDDING_DIMENSIONS=1536

# Reranker backend config (ORQ-22 benchmark adapters, ORQ-23 production use).
# AWS_RERANK_REGION=us-west-2: the region ORQ-22's quality benchmark actually
# ran against (docs/reranking_benchmark.md) -- not ca-central-1, which was
# only the fastest region in a separate, unpaced latency probe.
# Project/model values that depend on local credentials remain blank.
AWS_RERANK_REGION=us-west-2
AWS_RERANK_MODEL=amazon.rerank-v1:0
GCP_PROJECT_ID=
GCP_RERANK_LOCATION=global
GCP_RERANK_MODEL=semantic-ranker-default-004
GOOGLE_ADC_HOST_PATH=/path/to/application_default_credentials.json
QWEN_MODEL_ID=
QWEN_DEVICE=cuda
RERANKING_BENCHMARK_GCP_ENABLED=false
RERANKING_BENCHMARK_AWS_ENABLED=false
RERANKING_BENCHMARK_QWEN_ENABLED=false
RERANKING_BENCHMARK_GCP_CALL_BUDGET=0
RERANKING_BENCHMARK_AWS_PACING_S=15

# Retrieval pipeline (ORQ-23): rewrite -> retrieve -> rerank -> evaluator.
# Disabled by default; requires RAG_ENABLED=true and DATABASE_URL_APP too.
RETRIEVAL_PIPELINE_ENABLED=false
RETRIEVAL_PIPELINE_MIN_RERANKED_RESULTS=5

# ORQ-25 /chat augmentation. Independent from RAG_ENABLED and the read-only
# retrieval endpoint flag; DATABASE_URL_APP is required when enabled.
CHAT_RAG_AUGMENTATION_ENABLED=false
CHAT_RAG_RETRIEVAL_TIMEOUT_S=30
CHAT_RAG_MAX_SOURCES=5
CHAT_RAG_MAX_SOURCE_CHARS=4000
CHAT_RAG_MAX_CONTEXT_CHARS=12000

# Redis (recommended Docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# CORS (ORQ-19.6): comma-separated origins allowed to call the API from a
# browser. Blank/unset falls back to http://localhost:5173.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Controlled Web Read (consolidated, operator-ready)
WEB_READ_ENABLED=true
WEB_READ_ALLOW_HTTP=false
WEB_READ_ALLOWED_DOMAINS=
WEB_READ_TIMEOUT_S=5
WEB_READ_MAX_BYTES=32768
WEB_READ_MAX_CHARS=4000

# Controlled Notion Read via MCP (consolidated, operator-ready)
NOTION_READ_ENABLED=false
NOTION_MCP_ENABLED=false
NOTION_MCP_SERVER_COMMAND=node
NOTION_MCP_SERVER_ARGS=["/notion-mcp-server/dist/server.js"]
NOTION_MCP_SERVER_CWD=/notion-mcp-server
NOTION_MCP_TIMEOUT_S=10
NOTION_ALLOWED_PAGE_IDS=

# Controlled Notion Write (MVP)
NOTION_WRITE_ENABLED=false
NOTION_API_TOKEN=
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11
NOTION_WRITE_TIMEOUT_S=10
NOTION_ALLOWED_DATABASE_IDS=

# Local alias -> Notion property mapping.
# Use the exact Notion property name or property id in the value below.
# Example:
# NOTION_EDITABLE_FIELDS={
#   "page_or_row_id_placeholder": {
#     "status": {
#       "type": "select",
#       "options": ["todo", "in_progress", "done"],
#       "notion_property_name": "Status"
#     },
#     "priority": {
#       "type": "select",
#       "options": ["high", "medium", "low"],
#       "notion_property_name": "Priority"
#     }
#   }
# }
NOTION_EDITABLE_FIELDS=

# Row creation templates may use the same explicit Notion property key mapping.
# Example:
# NOTION_DATABASE_TEMPLATES={
#   "database_id_placeholder": {
#     "Name": {"type": "title", "required": true, "notion_property_name": "Name"},
#     "Status": {"type": "status", "options": ["todo", "done"], "required": true, "notion_property_name": "Status"}
#   }
# }
NOTION_DATABASE_TEMPLATES=
