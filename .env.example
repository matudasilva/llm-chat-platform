# App
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=llm-chat-platform
API_PORT=8000

# Provider
PROVIDER=stub
PROVIDER_TIMEOUT_S=30

# Stub provider
STUB_PROVIDER_MODE=ok
STUB_SIMULATED_LATENCY_MS=0

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_ATTEMPTS=3
OPENAI_BACKOFF_BASE_MS=200
OPENAI_BACKOFF_MAX_MS=2000

# Postgres (recommended Docker service name: postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=llmchat
POSTGRES_USER=llmchat
POSTGRES_PASSWORD=__CHANGEME__

# DATABASE_URL (computed by settings.database_url)
# SQLAlchemy (single source of truth for DB connectivity)
DATABASE_URL=postgresql+asyncpg://llmchat:change_me@postgres:5432/llmchat

# Redis (recommended Docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Controlled Web Read (consolidated, operator-ready)
WEB_READ_ENABLED=true
WEB_READ_ALLOW_HTTP=false
WEB_READ_ALLOWED_DOMAINS=
WEB_READ_TIMEOUT_S=5
WEB_READ_MAX_BYTES=32768
WEB_READ_MAX_CHARS=4000

# Controlled Notion Read via MCP (consolidated, operator-ready)
NOTION_READ_ENABLED=false
NOTION_MCP_ENABLED=false
NOTION_MCP_SERVER_COMMAND=node
NOTION_MCP_SERVER_ARGS=["/notion-mcp-server/dist/server.js"]
NOTION_MCP_SERVER_CWD=/notion-mcp-server
NOTION_MCP_TIMEOUT_S=10
NOTION_ALLOWED_PAGE_IDS=

# Controlled Notion Write (MVP)
NOTION_WRITE_ENABLED=false
NOTION_API_TOKEN=
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11
NOTION_WRITE_TIMEOUT_S=10
NOTION_ALLOWED_DATABASE_IDS=

# Local alias -> Notion property mapping.
# Use the exact Notion property name or property id in the value below.
# Example:
# NOTION_EDITABLE_FIELDS={
#   "page_or_row_id_placeholder": {
#     "status": {
#       "type": "select",
#       "options": ["todo", "in_progress", "done"],
#       "notion_property_name": "Status"
#     },
#     "priority": {
#       "type": "select",
#       "options": ["high", "medium", "low"],
#       "notion_property_name": "Priority"
#     }
#   }
# }
NOTION_EDITABLE_FIELDS=

# Row creation templates may use the same explicit Notion property key mapping.
# Example:
# NOTION_DATABASE_TEMPLATES={
#   "database_id_placeholder": {
#     "Name": {"type": "title", "required": true, "notion_property_name": "Name"},
#     "Status": {"type": "status", "options": ["todo", "done"], "required": true, "notion_property_name": "Status"}
#   }
# }
NOTION_DATABASE_TEMPLATES=
