+    result = subprocess.run([sys.executable, "-c", code], check=True, capture_output=True,
+                            text=True, env=env, timeout=20)
+    assert json.loads(result.stdout.splitlines()[-1]) == dict(
+        actual_install_passed=True, requests=0, postgres_calls=0, redis_calls=0)
