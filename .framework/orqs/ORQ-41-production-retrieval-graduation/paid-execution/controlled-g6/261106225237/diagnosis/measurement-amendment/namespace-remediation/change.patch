+def test_worker_main_startup_uses_real_install_before_io(packet, tmp_path, entry, expected):
+    """Exercise the missed main/install handoff; stop before the real lifespan's I/O."""
+    plan, _ = packet
+    driver.write_json(tmp_path / "plan.json", plan)
+    code = r'''
+import asyncio,json,os
+from contextlib import asynccontextmanager
+from pathlib import Path
+from app.main import app
+from app.core.settings import settings
+from app.services import chat_response_cache
+from experiments.production_graduation.gate_validation import blocked_latency as d
+from experiments.production_graduation.gate_validation import blocked_latency_worker as w
+from experiments.production_graduation.gate_validation.local_api import NamespacedRedis
+from experiments.production_graduation.gate_validation.validate_g123 import config_identity
+
+out=Path(os.environ['G6_RUN_DIR']);plan=json.loads((out/'plan.json').read_text())
+plan['seed_probe']=d.seed_probe();plan['config_sha256'][os.environ['G6_ARM']]=config_identity(settings)
+(out/'plan.json').write_text(json.dumps(plan))
+d.write_json(out/'execution-started.json',dict(plan_sha256=d.sha_file(out/'plan.json')))
+class StartupReached(Exception):pass
+@asynccontextmanager
+async def no_io_lifespan(application):
+ assert application.state.g123_installed is True
+ assert isinstance(chat_response_cache.redis_client,NamespacedRedis)
+ assert chat_response_cache.redis_client.namespace==os.environ['EXPECTED_NAMESPACE']
+ raise StartupReached('actual install passed; stop before actual app startup I/O')
+ yield
+app.router.lifespan_context=no_io_lifespan
+async def forbidden_block(*args,**kwargs):raise AssertionError('Unit startup probe cannot admit requests')
+w.run_block=forbidden_block
+try:asyncio.run(w.main())
+except StartupReached:print(json.dumps(dict(actual_install_passed=True,requests=0,postgres_calls=0,redis_calls=0)))
+else:raise AssertionError('Expected startup boundary sentinel')
+'''
+    env = {**os.environ, **driver.worker_environment(plan, PASSWORDS, entry)}
