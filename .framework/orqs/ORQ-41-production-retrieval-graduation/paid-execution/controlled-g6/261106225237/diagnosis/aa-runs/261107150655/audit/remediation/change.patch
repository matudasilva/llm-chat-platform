+"""Performance-only release guards and deterministic local JSON/SSE regressions."""
+import ast
+import asyncio
+import copy
+import gc
+import hashlib
+import json
+import weakref
+from contextlib import nullcontext
+from pathlib import Path
+from types import SimpleNamespace as NS
+from uuid import UUID, uuid5
+
+import httpx
+import pytest
+
+from app.core.observability import context_evidence as c1
+from app.core.domain.provider import ProviderInput
+from app.core.domain.types import ChatMessage
+from app.http.request_context import set_telemetry_identity, reset_telemetry_identity
+from experiments.production_graduation.gate_validation.capture import Capture
+from experiments.production_graduation.gate_validation.controlled_latency import candidate_evidence
+from experiments.production_graduation.gate_validation.fixtures import HarnessError
+from experiments.production_graduation.gate_validation.local_api import Lifecycle, LocalASGI
+from experiments.production_graduation.gate_validation.performance_cleanup import release_validated_case
+from experiments.production_graduation.gate_validation.transports import Barriers, Reply, ScopedProvider, Tape, native_provider, with_purpose
+
+
+class Session:
+    active = False
+    def in_transaction(self): return self.active
+
+
+def case(candidate=True):
+    lifecycle=Lifecycle();lifecycle.requests.append(dict(completed=1.0,outcome='returned'))
+    session=Session();lifecycle.sessions.append(session);lifecycle.closed_sessions.add(session)
+    lifecycle.backend_pids.append(1)
+    scoped=NS(tasks=set(),barriers=Barriers(),provider=NS(fault_events=[]))
+    scoped.barriers.timeline.append(('completed',1.0))
+    request_id=str(UUID(int=41));instance=str(UUID(int=42))
+    with c1.request_evidence(instance,request_id) as state: pass
+    if candidate: lifecycle.evidence_states.append(state)
+    capture=Capture() if candidate else Tape()
+    capture.bodies[:]=[b'rewrite',b'primary']
+    dispatches=[dict(purpose=p,sha256=hashlib.sha256(raw).hexdigest()) for p,raw in zip(('rewrite','primary'),capture.bodies)]
+    capture.sends[:]=[dict(purpose=d['purpose'],correlation_id=request_id,
+        **{('payload_sha256' if candidate else 'sha256'):d['sha256']}) for d in dispatches]
+    row=dict(status='PASS',error=None,request_id=request_id,accounting_instance_id=instance if candidate else None,dispatches=copy.deepcopy(dispatches))
+    return lifecycle,capture,scoped,row,state
+
+
+def retained(lifecycle,capture,scoped):
+    return [list(v) for v in (capture.bodies,capture.sends,lifecycle.evidence_states,lifecycle.tasks,
+        lifecycle.requests,lifecycle.sessions,lifecycle.closed_sessions,lifecycle.backend_pids,scoped.tasks,
+        scoped.barriers.timeline,scoped.barriers.reached,scoped.barriers.released,scoped.barriers.waiters)]
+
+
+@pytest.mark.parametrize('candidate',[False,True])
+def test_release_preserves_projection_and_releases_only_validated_retention(candidate):
+    lifecycle,capture,scoped,row,_=case(candidate);expected=copy.deepcopy(row)
+    release_validated_case(lifecycle,capture,scoped,row,candidate=candidate)
+    assert row==expected and all(not values for values in retained(lifecycle,capture,scoped))
+
+
+def test_busy_candidate_context_fails_without_waiting_or_releasing_evidence():
+    lifecycle,capture,scoped,row,state=case();calls=[]
+    state.lock=NS(acquire=lambda **kw: calls.append(kw) or False,
+        release=lambda: pytest.fail('Cannot release an unowned lock'))
+    before=retained(lifecycle,capture,scoped)
+    with pytest.raises(HarnessError): release_validated_case(lifecycle,capture,scoped,row,candidate=True)
+    assert calls==[{'blocking':False}] and retained(lifecycle,capture,scoped)==before
+
+
+@pytest.mark.parametrize('fault',['failed_row','error_row','running_request','aborted_request','duplicate_request',
+    'task_pending','scope_pending','transaction','unclosed_session','orphan_session','fault','scenario',
+    'provider_fault','held_barrier','barrier_waiter','missing_body','changed_body','changed_projection',
+    'wrong_capture_request','invalid_state','unclosed_state','wrong_instance','late_observation'])
+@pytest.mark.asyncio
+async def test_unsafe_release_preserves_evidence_and_does_not_cancel_work(fault):
+    lifecycle,capture,scoped,row,state=case();future=None
+    if fault=='failed_row': row['status']='FAIL'
+    elif fault=='error_row': row['error']='retained failure'
+    elif fault=='running_request': lifecycle.requests[0]['completed']=None
+    elif fault=='aborted_request': lifecycle.requests[0]['outcome']='CancelledError'
+    elif fault=='duplicate_request': lifecycle.requests.append(lifecycle.requests[0])
+    elif fault in ('task_pending','scope_pending'):
+        future=asyncio.get_running_loop().create_future()
+        (lifecycle.tasks if fault=='task_pending' else scoped.tasks).add(future)
+    elif fault=='transaction': lifecycle.sessions[0].active=True
+    elif fault=='unclosed_session': lifecycle.closed_sessions.clear()
+    elif fault=='orphan_session': lifecycle.closed_sessions.add(Session())
+    elif fault=='fault': lifecycle.faults_triggered.append('unexpected')
+    elif fault=='scenario': lifecycle.scenario_receipts.append({'retained':'oracle'})
+    elif fault=='provider_fault': scoped.provider.fault_events.append('unexpected')
+    elif fault=='held_barrier': scoped.barriers.held=frozenset({'held'})
+    elif fault=='barrier_waiter': scoped.barriers.waiters['held']={object():{}}
+    elif fault=='missing_body': capture.bodies.pop()
+    elif fault=='changed_body': capture.bodies[0]=b'changed'
+    elif fault=='changed_projection': row['dispatches'][0]['sha256']='f'*64
+    elif fault=='wrong_capture_request': capture.sends[0]['correlation_id']='wrong'
+    elif fault=='invalid_state': state.valid=False
+    elif fault=='unclosed_state': state.closed=False
+    elif fault=='wrong_instance': state.instance_id=str(UUID(int=43))
+    elif fault=='late_observation':
+        token=c1._current.set(state)
+        try: c1.observe('late',lambda _: {})
+        finally: c1._current.reset(token)
+        assert state.valid is False
+    before=retained(lifecycle,capture,scoped);saved=copy.deepcopy(row)
+    with pytest.raises(HarnessError): release_validated_case(lifecycle,capture,scoped,row,candidate=True)
+    assert retained(lifecycle,capture,scoped)==before and row==saved
+    if future is not None:
+        assert not future.cancelled() and not future.done()
+        future.cancel()  # Test teardown only; release_validated_case never cancels.
+
+
+@pytest.mark.asyncio
+async def test_completed_cancelled_listener_is_quiescent_without_consuming_its_result():
+    lifecycle,capture,scoped,row,_=case()
+    future=asyncio.get_running_loop().create_future();future.cancel();lifecycle.tasks.add(future)
+    release_validated_case(lifecycle,capture,scoped,row,candidate=True)
+    assert future.cancelled() and not lifecycle.tasks
+
