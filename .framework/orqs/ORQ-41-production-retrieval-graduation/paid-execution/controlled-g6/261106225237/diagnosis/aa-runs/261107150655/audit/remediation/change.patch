+@pytest.mark.parametrize('candidate',[False,True])
+@pytest.mark.parametrize('protocol',['json','sse'])
+@pytest.mark.asyncio
+async def test_local_native_json_sse_contexts_are_released_across_repeated_cases(candidate,protocol):
+    lifecycle=Lifecycle();barriers=Barriers();capture=Capture() if candidate else Tape()
+    replies={'rewrite':Reply('rewritten'),'primary':Reply('Controlled local response.',chunks=('Controlled ','local response.'))}
+    provider,close=native_provider('bedrock',capture,replies)
+    scoped=ScopedProvider(provider,candidate=candidate,barriers=barriers)
+    refs=[];saved_rows=[]
+    async def app(scope,receive,send):
+        request_id=dict(scope['headers'])[b'x-request-id'].decode()
+        instance=str(uuid5(UUID(int=42),request_id));tokens=set_telemetry_identity(instance,request_id)
+        state=None
+        try:
+            with c1.request_evidence(instance,request_id) if candidate else nullcontext() as state:
+                pin=ProviderInput(request_id=UUID(request_id),messages=(ChatMessage(role='user',content='query'),))
+                await with_purpose(scoped.generate,'rewrite')(pin)
+                if protocol=='sse':
+                    stream=await scoped.stream(pin)
+                    chunks=[chunk async for chunk in stream.chunks]
+                    final=await stream.get_final_result()
+                    assert ''.join(chunks)==final.content=='Controlled local response.'
+                    body=b'event: done\ndata: {"status":"success"}\n\n'
+                    content_type=b'text/event-stream'
+                else:
+                    result=await scoped.generate(pin)
+                    assert result.content=='Controlled local response.'
+                    body=b'{"status":"success"}';content_type=b'application/json'
+                session=Session();lifecycle.sessions.append(session);lifecycle.closed_sessions.add(session)
+                await send(dict(type='http.response.start',status=200,headers=[(b'content-type',content_type)]))
+                await send(dict(type='http.response.body',body=body,more_body=False))
+        finally:
+            reset_telemetry_identity(*tokens)
+            if state is not None:
+                lifecycle.evidence_states.append(state);refs.append(weakref.ref(state))
+    try:
+        transport=httpx.ASGITransport(app=LocalASGI(app,lifecycle,barriers))
+        with lifecycle.track_tasks():
+            async with httpx.AsyncClient(transport=transport,base_url='http://local') as client:
+                for index in range(8):
+                    rid=str(uuid5(UUID(int=41),str(index)))
+                    response=await client.post('/chat',headers={'X-Request-ID':rid})
+                    assert response.status_code==200
+                    assert b'success' in response.content
+                    await lifecycle.quiesce(asyncio.get_running_loop().time()+1)
+                    instance=candidate_evidence(lifecycle.snapshots,capture.sends,rid) if candidate else None
+                    row=dict(status='PASS',error=None,request_id=rid,accounting_instance_id=instance,
+                        dispatches=[dict(purpose=send['purpose'],sha256=hashlib.sha256(raw).hexdigest()) for raw,send in zip(capture.bodies,capture.sends)])
+                    saved=copy.deepcopy(row);saved_rows.append(row)
+                    release_validated_case(lifecycle,capture,scoped,row,candidate=candidate)
+                    assert row==saved and all(not v for v in retained(lifecycle,capture,scoped))
+                    await asyncio.sleep(0);gc.collect()  # Reachability check only, never benchmark policy.
+                    assert all(ref() is None for ref in refs)
+        assert len(saved_rows)==8 and all(len(row['dispatches'])==2 for row in saved_rows)
+    finally:
+        await scoped.quiesce();await close()
