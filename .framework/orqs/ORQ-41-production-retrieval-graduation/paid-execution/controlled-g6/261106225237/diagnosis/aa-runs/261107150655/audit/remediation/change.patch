+"""Release validated performance-case retention; never production startup code.
+
+Call only after response parsing, lifecycle quiescence and full candidate/transport
+validation. Keep the projected result row; do not call on failed cases. No waits,
+cancellation, forced collection or application/session operations occur here.
+"""
+import hashlib
+
+from .fixtures import HarnessError
+
+
+def release_validated_case(lifecycle, capture, scoped, row, *, candidate):
+    if row['status'] != 'PASS' or row['error'] is not None:
+        raise HarnessError('Cannot release failed performance evidence')
+    if len(lifecycle.requests) != 1:
+        raise HarnessError('Ambiguous performance request ownership')
+    request = lifecycle.requests[0]
+    if request['completed'] is None or request['outcome'] != 'returned':
+        raise HarnessError('Performance response has not completed')
+    if any(not task.done() for task in lifecycle.tasks | scoped.tasks):
+        raise HarnessError('Performance tasks remain pending')
+    if (set(lifecycle.sessions) != lifecycle.closed_sessions
+            or any(session.in_transaction() for session in lifecycle.sessions)):
+        raise HarnessError('Performance sessions are unresolved')
+    if (lifecycle.faults_triggered or lifecycle.scenario_receipts
+            or getattr(scoped.provider, 'fault_events', ())):
+        raise HarnessError('Cannot discard unexpected fault evidence')
+    barriers = scoped.barriers
+    if barriers.held or any(barriers.waiters.values()):
+        raise HarnessError('Performance barriers remain owned')
+    if len(capture.bodies) != 2 or len(capture.sends) != 2 or len(row['dispatches']) != 2:
+        raise HarnessError('Incomplete retained transport projection')
+    for raw, send, projected, purpose in zip(capture.bodies, capture.sends, row['dispatches'], ('rewrite', 'primary')):
+        digest = hashlib.sha256(raw).hexdigest()
+        if (projected != {'purpose': purpose, 'sha256': digest}
+                or send['purpose'] != purpose or send['correlation_id'] != row['request_id']
+                or send.get('payload_sha256' if candidate else 'sha256') != digest):
+            raise HarnessError('Retained transport projection changed')
+    if candidate:
+        if len(lifecycle.evidence_states) != 1:
+            raise HarnessError('Missing candidate context at release')
+        state = lifecycle.evidence_states[0]
+        if not state.lock.acquire(blocking=False):
+            raise HarnessError('Candidate context remains owned')
+        try:
+            if (state.closed is not True or state.valid is not True
+                    or state.instance_id != row['accounting_instance_id']
+                    or state.correlation_id != row['request_id']):
+                raise HarnessError('Late or contradictory candidate evidence')
+        finally:
+            state.lock.release()
+    elif lifecycle.evidence_states or row['accounting_instance_id'] is not None:
+        raise HarnessError('Unexpected candidate evidence in baseline')
+
+    # All checks precede mutation; retain the already validated row and its hashes.
+    for collection in (capture.bodies, capture.sends, lifecycle.evidence_states,
+            lifecycle.tasks, lifecycle.requests, lifecycle.sessions,
+            lifecycle.closed_sessions, lifecycle.backend_pids, scoped.tasks,
+            barriers.timeline, barriers.reached, barriers.released, barriers.waiters):
+        collection.clear()
