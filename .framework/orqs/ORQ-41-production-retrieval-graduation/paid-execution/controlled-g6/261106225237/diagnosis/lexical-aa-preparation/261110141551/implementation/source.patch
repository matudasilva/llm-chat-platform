+def _image_chain_double(monkeypatch, mutate):
+    """Hash-consistent synthetic receipts exercise policy below the outer pin.
+
+    Real repository artifacts remain read-only. Rebinding the expected approval
+    hash is a unit seam, not an operation exposed to preparation callers.
+    """
+    approval = json.loads(driver.IMAGE_APPROVAL.read_text())
+    pin_path = driver.ROOT / approval["image_pin_receipt"]
+    review_path = driver.ROOT / approval["source_patch_review"]
+    inventory_path = pin_path.parent / "candidate-inventory.json"
+    objects = dict(approval=approval, pin=json.loads(pin_path.read_text()),
+                   review=json.loads(review_path.read_text()), inventory=json.loads(inventory_path.read_text()))
+    mutate(objects)
+    encode = lambda value: json.dumps(value, sort_keys=True)
+    digest = lambda value: hashlib.sha256(encode(value).encode()).hexdigest()
+    objects["pin"]["source_patch_review_sha256"] = digest(objects["review"])
+    objects["pin"]["candidate_inventory_sha256"] = digest(objects["inventory"])
+    approval["source_patch_review_sha256"] = digest(objects["review"])
+    approval["image_pin_receipt_sha256"] = digest(objects["pin"])
+    payloads = {path: encode(objects[name]) for path, name in (
+        (driver.IMAGE_APPROVAL, "approval"), (pin_path, "pin"),
+        (review_path, "review"), (inventory_path, "inventory"))}
+    read, sha = Path.read_text, driver.sha_file
+    monkeypatch.setattr(Path, "read_text", lambda path, *a, **k: payloads[path] if path in payloads else read(path, *a, **k))
+    monkeypatch.setattr(driver, "sha_file", lambda path: hashlib.sha256(payloads[Path(path)].encode()).hexdigest()
+                        if Path(path) in payloads else sha(path))
+    monkeypatch.setattr(driver, "IMAGE_APPROVAL_SHA256", digest(approval))
+
+
+def _source_review_double(monkeypatch, mutate=lambda value: None):
+    value = dict(status="LEXICAL_AA_IMAGE_BINDING_SOURCE_REVIEW_PASS",
+                 image_amendment_approval_sha256=driver.IMAGE_APPROVAL_SHA256,
+                 technical_files_sha256={name: driver.sha_file(driver.ROOT / name) for name in (
+                     "experiments/production_graduation/gate_validation/blocked_latency.py",
+                     "tests/experiments/test_orq41_blocked_latency.py")})
+    mutate(value)
+    raw = json.dumps(value)
+    digest = hashlib.sha256(raw.encode()).hexdigest()
+    read, sha = Path.read_text, driver.sha_file
+    monkeypatch.setattr(Path, "read_text", lambda path, *a, **k: raw if path == driver.IMAGE_SOURCE_REVIEW else read(path, *a, **k))
+    monkeypatch.setattr(driver, "sha_file", lambda path: digest if Path(path) == driver.IMAGE_SOURCE_REVIEW else sha(path))
+    return digest
+
